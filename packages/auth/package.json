  },
  "devDependencies": {
    "@blak/typescript-config": "workspace:*",
    "@types/node": "^26.0.0",
    "@types/react": "^19",
    "next": "^16.2.6",
    "react": "^19.2.4",
    "tsx": "^4.22.4"
  }
}
